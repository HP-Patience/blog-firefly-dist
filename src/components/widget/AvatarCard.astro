---
import ImageWrapper from "@/components/common/ImageWrapper.astro";

interface Props {
	src: string;
	alt?: string;
}

const { src, alt = "Avatar" } = Astro.props;
---

<div class="avatar-card cursor-pointer">
  <div class="avatar-card__translater">
    <div class="avatar-card__rotator">
      <div class="avatar-card__front">
        <ImageWrapper
          src={src}
          alt={alt}
          loading="eager"
          fetchpriority="high"
          widths={[350]}
          sizes="350px"
        />
      </div>
      <div class="avatar-card__glare"></div>
      <div class="avatar-card__back">
        <img src={src} alt={alt} class="avatar-card__back-img" />
      </div>
    </div>
  </div>
</div>

<style>
  @property --glare-x {
    syntax: "<percentage>";
    initial-value: 50%;
    inherits: true;
  }
  @property --glare-y {
    syntax: "<percentage>";
    initial-value: 50%;
    inherits: true;
  }

  .avatar-card {
    --card-scale: 1;
    --card-opacity: 0;
    --rotate-x: 0deg;
    --rotate-y: 0deg;
    --glare-x: 50%;
    --glare-y: 50%;
    --translate-x: 0px;
    --translate-y: 0px;

    display: inline-block;
    perspective: 600px;
    z-index: 1;
    width: 100%;
    transition: z-index 0s step-end;
  }

  .avatar-card.interacting {
    z-index: 999;
    transition: z-index 0s step-start;
  }

  .avatar-card__translater {
    position: relative;
    transform: translate3d(var(--translate-x), var(--translate-y), 0)
      scale(var(--card-scale));
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }

  .avatar-card__rotator {
    display: grid;
    transform-style: preserve-3d;
    transform: rotateY(var(--rotate-x)) rotateX(var(--rotate-y));
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
    border-radius: 12px;
  }

  .avatar-card:hover .avatar-card__rotator {
    transition: transform 0.35s ease-out;
  }

  .avatar-card__rotator > * {
    grid-area: 1/1;
  }

  .avatar-card__front {
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0.01px);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }

  .avatar-card__front :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .avatar-card__back {
    backface-visibility: visible;
    transform: rotateY(180deg) translateZ(1px);
    border-radius: 12px;
    overflow: hidden;
  }

  .avatar-card__back-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
    transform: scaleX(-1);
  }

  .avatar-card__glare {
    grid-area: 1/1;
    z-index: 2;
    pointer-events: none;
    border-radius: 12px;
    background: radial-gradient(
      farthest-corner circle at var(--glare-x) var(--glare-y),
      rgba(255, 255, 255, 0.8) 0%,
      rgba(255, 255, 255, 0.4) 18%,
      rgba(255, 255, 255, 0) 55%
    );
    opacity: var(--card-opacity);
    mix-blend-mode: overlay;
    transition: --glare-x 0.35s ease-out, --glare-y 0.35s ease-out,
      opacity 0.4s ease;
  }

  .avatar-card:not(.active) .avatar-card__rotator::after {
    content: "";
    grid-area: 1/1;
    z-index: 3;
    pointer-events: none;
    border-radius: 12px;
    opacity: var(--card-opacity);
    transition: opacity 0.5s ease;
    box-shadow: inset 0 0 12px 3px rgba(255, 255, 255, 0.15),
      0 0 8px 2px rgba(255, 255, 255, 0.1);
  }

  @media (hover: hover) {
    .avatar-card:not(.active):hover {
      filter: drop-shadow(0 0 12px rgba(100, 180, 255, 0.5))
        drop-shadow(0 0 24px rgba(100, 180, 255, 0.25));
    }
  }
</style>

<style is:global>
  .avatar-card-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 998;
    animation: avatar-overlay-in 0.4s ease-out;
    overflow: hidden;
  }

  @keyframes avatar-overlay-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .avatar-card-overlay.closing {
    animation: avatar-overlay-out 0.35s ease-in forwards;
  }

  @keyframes avatar-overlay-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  .avatar-card-overlay .avatar-card {
    position: absolute;
    z-index: 999;
    perspective: 900px;
    width: min(80vw, 380px);
    transition:
      left 0.86s cubic-bezier(0.42, 0, 0.58, 1),
      top 0.86s cubic-bezier(0.42, 0, 0.58, 1);
  }

  .avatar-card-overlay .avatar-card__translater {
    transition: transform 0.86s cubic-bezier(0.42, 0, 0.58, 1);
  }

  .avatar-card-overlay.closing .avatar-card {
    transition:
      left 0.4s ease-in,
      top 0.4s ease-in;
  }
  .avatar-card-overlay.closing .avatar-card__translater {
    transition: transform 0.4s ease-in;
  }

  .avatar-card-overlay .avatar-card__rotator {
    animation: avatar-flip-once 0.88s cubic-bezier(0.42, 0, 0.58, 1);
  }

  @keyframes avatar-flip-once {
    0% {
      transform: rotateY(0deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  .avatar-card-overlay .avatar-card__front,
  .avatar-card-overlay .avatar-card__back,
  .avatar-card-overlay .avatar-card__glare,
  .avatar-card-overlay .avatar-card__front :global(img),
  .avatar-card-overlay .avatar-card__back-img {
    border-radius: 24px;
  }

  .avatar-card-close-hint {
    position: fixed;
    bottom: 48px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.5);
    font-size: 13px;
    z-index: 1000;
    user-select: none;
    pointer-events: none;
    font-family: system-ui, sans-serif;
  }

  .avatar-card-motto {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1001;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    pointer-events: none;
    user-select: none;
  }

  .avatar-card-motto__char {
    font-family: "Georgia", "Times New Roman", serif;
    font-size: 40px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
    white-space: pre;
    opacity: 0;
    animation: motto-char-in 0.5s ease-out forwards;
  }

  @keyframes motto-char-in {
    0% {
      opacity: 0;
      text-shadow: 0 0 0px rgba(255, 255, 255, 0);
    }
    60% {
      opacity: 1;
      text-shadow: 0 0 16px rgba(255, 255, 255, 0.8);
    }
    100% {
      opacity: 1;
      text-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
    }
  }
</style>

<script>
  (function () {
    let overlayEl = null;
    let expanded = false;
    let savedRect = null;

    function init() {
      const card = document.querySelector(".avatar-card");
      if (!card) return;
      if (card.dataset.avatarCardInit) return;
      card.dataset.avatarCardInit = "1";

      card.addEventListener("mousemove", onMouseMove);
      card.addEventListener("mouseenter", onMouseEnter);
      card.addEventListener("mouseleave", onMouseLeave);
      card.addEventListener("click", onClick);

      // touch support
      card.addEventListener("touchmove", onTouchMove, { passive: false });
      card.addEventListener("touchend", onTouchEnd);
    }

    /* ---------- mouse tracking ---------- */

    function onMouseEnter(e) {
      const card = e.currentTarget;
      if (card.classList.contains("active")) return;
      card.style.setProperty("--card-opacity", "0.9");
      card.classList.add("interacting");
    }

    function onMouseLeave(e) {
      const card = e.currentTarget;
      card.style.setProperty("--card-opacity", "0");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");
      card.classList.remove("interacting");
    }

    function onMouseMove(e) {
      const card = e.currentTarget;
      if (card.classList.contains("active")) return;

      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;

      let ox = (e.clientX - cx) / (rect.width / 2);
      let oy = (e.clientY - cy) / (rect.height / 2);
      ox = Math.max(-1, Math.min(1, ox));
      oy = Math.max(-1, Math.min(1, oy));

      const maxTilt = 18;
      card.style.setProperty("--rotate-x", (ox * maxTilt).toFixed(2) + "deg");
      card.style.setProperty("--rotate-y", (-oy * maxTilt).toFixed(2) + "deg");

      const gx = ((e.clientX - rect.left) / rect.width) * 100;
      const gy = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty("--glare-x", gx.toFixed(1) + "%");
      card.style.setProperty("--glare-y", gy.toFixed(1) + "%");
    }

    /* ---------- touch ---------- */

    let touchActive = false;
    function onTouchMove(e) {
      if (expanded) return;
      e.preventDefault();
      touchActive = true;
      const touch = e.touches[0];
      const card = e.currentTarget;
      if (card.classList.contains("active")) return;

      card.style.setProperty("--card-opacity", "0.9");
      card.classList.add("interacting");

      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;

      let ox = (touch.clientX - cx) / (rect.width / 2);
      let oy = (touch.clientY - cy) / (rect.height / 2);
      ox = Math.max(-1, Math.min(1, ox));
      oy = Math.max(-1, Math.min(1, oy));

      const maxTilt = 18;
      card.style.setProperty("--rotate-x", (ox * maxTilt).toFixed(2) + "deg");
      card.style.setProperty("--rotate-y", (-oy * maxTilt).toFixed(2) + "deg");

      const gx = ((touch.clientX - rect.left) / rect.width) * 100;
      const gy = ((touch.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty("--glare-x", gx.toFixed(1) + "%");
      card.style.setProperty("--glare-y", gy.toFixed(1) + "%");
    }

    function onTouchEnd(e) {
      if (!touchActive) return;
      touchActive = false;
      if (expanded) return;
      const card = e.currentTarget;
      card.style.setProperty("--card-opacity", "0");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");
      card.classList.remove("interacting");
    }

    /* ---------- click to expand ---------- */

    function onClick(e) {
      if (expanded) return;
      e.stopPropagation();
      e.preventDefault();
      expand(e.currentTarget);
    }

    function expand(card) {
      expanded = true;

      const rect = card.getBoundingClientRect();
      savedRect = {
        left: rect.left,
        top: rect.top,
        width: rect.width,
        height: rect.height,
      };

      card.classList.add("active");
      card.classList.remove("interacting");
      card.style.setProperty("--card-opacity", "0");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");

      overlayEl = document.createElement("div");
      overlayEl.className = "avatar-card-overlay";
      document.body.appendChild(overlayEl);

      overlayEl.appendChild(card);
      card.style.left = rect.left + "px";
      card.style.top = rect.top + "px";
      card.style.setProperty("--card-scale", "1");
      card.getBoundingClientRect();

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const expandedSize = Math.min(vw * 0.8, 380);
      card.style.left = (vw - expandedSize) / 2 + "px";
      card.style.top = (vh - expandedSize) / 2 + "px";

      const hint = document.createElement("div");
      hint.className = "avatar-card-close-hint";
      hint.textContent = "点击空白处 或 按 ESC 关闭";
      document.body.appendChild(hint);

      document.addEventListener("keydown", onKeyDown);
      overlayEl.addEventListener("click", onOverlayClick);
      document.body.style.overflow = "hidden";

      setTimeout(() => {
        card.addEventListener("mousemove", onExpandedMouseMove);
        card.addEventListener("mouseenter", onExpandedMouseEnter);
        card.addEventListener("mouseleave", onExpandedMouseLeave);

        // 逐字母显示 motto
        showMotto();
      }, 900);
    }

    function showMotto() {
      const existing = document.querySelector(".avatar-card-motto");
      if (existing) existing.remove();

      const card = document.querySelector(".avatar-card.active");
      if (!card) return;

      const cardRect = card.getBoundingClientRect();
      const gap = 30; // px between card bottom and text top

      const mottoText = "Where there's a will, there's a way.";
      const motto = document.createElement("div");
      motto.className = "avatar-card-motto";
      motto.style.top = cardRect.bottom + gap + "px";

      for (let i = 0; i < mottoText.length; i++) {
        const span = document.createElement("span");
        span.textContent = mottoText[i] === " " ? " " : mottoText[i];
        span.className = "avatar-card-motto__char";
        span.style.animationDelay = i * 60 + "ms";
        motto.appendChild(span);
      }

      document.body.appendChild(motto);
    }

    function collapse() {
      if (!expanded || !overlayEl) return;
      expanded = false;

      const card = overlayEl.querySelector(".avatar-card");
      if (!card) return;

      document.removeEventListener("keydown", onKeyDown);
      document.body.style.overflow = "";
      card.removeEventListener("mousemove", onExpandedMouseMove);
      card.removeEventListener("mouseenter", onExpandedMouseEnter);
      card.removeEventListener("mouseleave", onExpandedMouseLeave);

      const hint = document.querySelector(".avatar-card-close-hint");
      if (hint) hint.remove();

      const motto = document.querySelector(".avatar-card-motto");
      if (motto) motto.remove();

      card.style.left = savedRect.left + "px";
      card.style.top = savedRect.top + "px";
      card.style.setProperty("--card-scale", "1");
      card.style.setProperty("--card-opacity", "0");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");

      overlayEl.classList.add("closing");

      overlayEl.addEventListener(
        "animationend",
        function onAnimEnd() {
          overlayEl.removeEventListener("animationend", onAnimEnd);
          card.classList.remove("active");
          card.style.left = "";
          card.style.top = "";

          const profileCard = document.querySelector(".avatar-card-wrapper");
          if (profileCard) profileCard.appendChild(card);

          overlayEl.remove();
          overlayEl = null;
        },
        { once: true }
      );
    }

    function onOverlayClick(e) {
      if (e.target === overlayEl) collapse();
    }

    function onKeyDown(e) {
      if (e.key === "Escape") collapse();
    }

    /* ---------- mouse tilt inside overlay ---------- */

    function onExpandedMouseEnter(e) {
      e.currentTarget.style.setProperty("--card-opacity", "0.8");
    }

    function onExpandedMouseLeave(e) {
      const card = e.currentTarget;
      card.style.setProperty("--card-opacity", "0");
      card.style.setProperty("--rotate-x", "0deg");
      card.style.setProperty("--rotate-y", "0deg");
    }

    function onExpandedMouseMove(e) {
      const card = e.currentTarget;
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;

      let ox = (e.clientX - cx) / (rect.width / 2);
      let oy = (e.clientY - cy) / (rect.height / 2);
      ox = Math.max(-1, Math.min(1, ox));
      oy = Math.max(-1, Math.min(1, oy));

      const maxTilt = 12;
      card.style.setProperty("--rotate-x", (ox * maxTilt).toFixed(2) + "deg");
      card.style.setProperty("--rotate-y", (-oy * maxTilt).toFixed(2) + "deg");

      const gx = ((e.clientX - rect.left) / rect.width) * 100;
      const gy = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty("--glare-x", gx.toFixed(1) + "%");
      card.style.setProperty("--glare-y", gy.toFixed(1) + "%");
    }

    /* ---------- swup / navigation ---------- */

    function destroy() {
      if (expanded) {
        document.removeEventListener("keydown", onKeyDown);
        document.body.style.overflow = "";
        expanded = false;
      }
      if (overlayEl) {
        overlayEl.remove();
        overlayEl = null;
      }
      const hint = document.querySelector(".avatar-card-close-hint");
      if (hint) hint.remove();
      const motto = document.querySelector(".avatar-card-motto");
      if (motto) motto.remove();
    }

    window.AvatarCard = { init, destroy };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    // Re-init on swup page transitions
    document.addEventListener("swup:content:replace", init);
  })();
</script>
